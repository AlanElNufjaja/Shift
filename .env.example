# Optional: enable real P2 recommendations.
# If blank, the app uses fictional demo scenarios or an explicitly imported P2 file.
# Backend contract: POST /recomendar (configure CORS for cross-origin deployment).
# P1 files are never uploaded automatically.
VITE_API_URL=

# Optional: NASA POWER base path. Default: /nasa-power (Vite development proxy).
# Configure an equivalent proxy or rewrite on other hosting platforms.
VITE_POWER_API_BASE=

# Field Shift 3.3 global coordinates (FastAPI). By default use Vite proxy /api -> localhost:8000.
# For a deployed backend, set URL ending in /api and allow frontend origin on backend.
VITE_GLOBAL_API_BASE=

# AppEEARS automation is OFF by default; only enabled via backend/start-local.cmd
# Never put Earthdata credentials or tokens in VITE_ variables or in files under public/.

# Optional read-only USDA AMS MyMarketNews report explorer, LOCAL BACKEND ONLY.
# A personal free USDA API key must be set in the backend terminal (not here, not VITE_*).
# FIELD_SHIFT_MARKET_LOCAL_MODE=1
# FIELD_SHIFT_MMN_API_KEY=<your personal key>   <-- Do not commit credentials
# The new explorer does not recalculate pricing, revenue or crop rankings.
